FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    PORT=7071 \
    TTC_GTFS_STATIC_DIR=/app/data/gtfs-static

WORKDIR /app

COPY publisher/package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY ingest ./ingest
COPY src/types ./src/types
COPY data/gtfs-static/stop_times.txt ./data/gtfs-static/stop_times.txt
COPY data/gtfs-static/schedule-offsets.json ./data/gtfs-static/schedule-offsets.json

RUN node -e "const fs=require('node:fs');const source='/app/data/gtfs-static/stop_times.txt';const target='/app/data/gtfs-static/schedule-offsets.json';const index=JSON.parse(fs.readFileSync(target,'utf8'));const stat=fs.statSync(source);index.sourceSize=stat.size;index.sourceModifiedMs=stat.mtimeMs;fs.writeFileSync(target,JSON.stringify(index));" \
    && chown -R node:node /app

USER node
EXPOSE 7071

CMD ["./node_modules/.bin/tsx", "ingest/main.ts"]