{
  "name": "ttc-digital-twin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "template": {
    "name": "blankapp",
    "displayName": "Blank App",
    "description": "Bare-bones Fabric-authenticated React + Vite app — sign-in, routing, and a placeholder home page, with no data layer to remove"
  },
  "scripts": {
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "dev": "rayfin up --exclude-services staticHosting && vite",
    "dev:demo": "vite --mode demo",
    "ingest": "tsx ingest/main.ts",
    "ingest:once": "tsx ingest/main.ts --once",
    "fabric:plan": "tsx scripts/deployFabric.ts --dry-run",
    "fabric:deploy": "tsx scripts/deployFabric.ts",
    "fabric:publisher": "tsx scripts/runPublisher.ts",
    "gtfs:sync": "tsx scripts/syncGtfsStatic.ts",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "validate:ui": "tsx scripts/validateUi.ts",
    "build": "tsc -b && vite build",
    "build:fabric": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "rayfin:up": "rayfin up"
  },
  "dependencies": {
    "@microsoft/rayfin-auth-provider-fabric": "^1.34.0",
    "@microsoft/rayfin-client": "^1.34.0",
    "@microsoft/rayfin-core": "^1.34.0",
    "@microsoft/rayfin-data": "^1.34.0",
    "@tailwindcss/vite": "^4.1.11",
    "csv-parse": "^7.0.2",
    "gtfs-realtime-bindings": "^2.2.0",
    "kafkajs": "^2.2.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.29.0",
    "maplibre-gl": "^6.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/rayfin-cli": "^1.34.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^24.1.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
