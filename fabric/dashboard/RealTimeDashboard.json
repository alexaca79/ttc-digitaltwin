  "pages": [ { "id": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e1004", "name": "Live operations" } ],
  "queries": [
    { "id": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e2001", "dataSource": { "kind": "manual", "dataSourceId": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e1003" }, "text": "CurrentFleet() | summarize Vehicles = count()", "usedVariables": [] },
    { "id": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e2002", "dataSource": { "kind": "manual", "dataSourceId": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e1003" }, "text": "CurrentFleet() | where isnotnull(ScheduleDeviationSeconds) | summarize OnTimePercent = round(100.0 * countif(ScheduleDeviationSeconds >= -120 and ScheduleDeviationSeconds <= 180) / count(), 1)", "usedVariables": [] },
    { "id": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e2003", "dataSource": { "kind": "manual", "dataSourceId": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e1003" }, "text": "CurrentFleet() | summarize Delayed = countif(ScheduleDeviationSeconds > 180)", "usedVariables": [] },
    { "id": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e2004", "dataSource": { "kind": "manual", "dataSourceId": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e1003" }, "text": "ActiveAlerts() | summarize Alerts = count()", "usedVariables": [] },
    { "id": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e2011", "dataSource": { "kind": "manual", "dataSourceId": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e1003" }, "text": "VehiclePositions | summarize LastObservation = max(ObservedAt) | extend FeedAgeMinutes = round(datetime_diff('second', now(), LastObservation) / 60.0, 1) | project FeedAgeMinutes", "usedVariables": [] },
    { "id": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e2005", "dataSource": { "kind": "manual", "dataSourceId": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e1003" }, "text": "CurrentFleet() | project VehicleLabel, RouteId, Mode, State, ScheduleDeviationSeconds, Latitude, Longitude", "usedVariables": [] },
    { "id": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e2006", "dataSource": { "kind": "manual", "dataSourceId": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e1003" }, "text": "ActiveAlerts() | project ObservedAt, Severity, Title, Description | order by ObservedAt desc", "usedVariables": [] },
    { "id": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e2007", "dataSource": { "kind": "manual", "dataSourceId": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e1003" }, "text": "RoutePerformance(30m) | where isnotnull(OnTimePercent) | project RouteId, Mode, Vehicles, OnTimePercent, Delayed, P95DelaySeconds | order by Delayed desc | take 20", "usedVariables": [] },
    { "id": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e2008", "dataSource": { "kind": "manual", "dataSourceId": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e1003" }, "text": "CurrentFleet() | where isnotnull(ScheduleDeviationSeconds) | summarize Vehicles = count() by DelayMinutes = bin(ScheduleDeviationSeconds / 60, 2) | order by DelayMinutes asc", "usedVariables": [] },
    { "id": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e2010", "dataSource": { "kind": "manual", "dataSourceId": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e1003" }, "text": "CurrentFleet() | summarize Vehicles = count() by Mode", "usedVariables": [] },
    { "id": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e2009", "dataSource": { "kind": "manual", "dataSourceId": "9c1f0f4a-7d21-4a17-9d0f-2b6a4c8e1003" }, "text": "VehiclePositions | where ObservedAt between (_startTime .. _endTime) | summarize Vehicles = dcount(VehicleId) by bin(ObservedAt, 10m) | order by ObservedAt asc", "usedVariables": ["_startTime", "_endTime"] }
  ],
